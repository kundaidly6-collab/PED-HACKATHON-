# NOTE: in .gitignore a '#' only starts a comment at the START of a line.
# A trailing "# comment" becomes part of the pattern and silently never matches.
# (Learned the hard way: `runs/  # stuff` matched nothing and staged 5 MB of weights.)

# Generated / machine-specific — regenerate with the scripts, never commit.
# Ignore the WHOLE dataset tree. Listing individual subfolders (raw/, prepared/,
# _synthetic_demo/) silently stopped working the moment a test folder with another
# name appeared, and 230 generated files got committed. Negative patterns are
# brittle; one rule that cannot be outgrown is better.
dataset/
*.npy
*.cache
configs/data.prepared.yaml
runs/
*.pt
*.pth

# Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
